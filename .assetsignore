# Files in the deploy directory that Cloudflare wrangler should NOT upload
# as part of the Workers Assets bundle. Same syntax as .gitignore.
# Without excluding .git/, the compressed pack file can exceed the 25 MiB
# per-asset limit and the entire deploy fails.

# Git internals
.git/

# Wrangler / dev tooling
.gitignore
.assetsignore
wrangler.jsonc
wrangler.toml
node_modules/

# Dev docs — not needed at runtime, and MUST NOT be public: PROGRESS.md was
# served at HTTP 200 on the live domain until 2026-08-17 (internal session logs
# + the client's contact-form recipient email). Glob, so future docs are covered.
*.md

# Source media — only extracted hero frames are served, not the source video
hero-source.mp4
hero-source.mov
hero-source.webm

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log
